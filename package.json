{
  "name": "onigiribot",
  "version": "1.0.0",
  "description": "An open source, lightweight, do-it-all Discord bot with a web UI!",
  "main": "index.js",
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc",
    "test": "npm run test:typecheck && vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/index.ts",
    "deploy-commands": "ts-node src/utils/deploy-commands.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeke-code/OnigiriBot.git"
  },
  "author": "zeke-code",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/zeke-code/OnigiriBot/issues"
  },
  "homepage": "https://github.com/zeke-code/OnigiriBot#readme",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/adapter-pg": "^7.10.1",
    "axios": "^1.21.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "shoukaku": "^4.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
